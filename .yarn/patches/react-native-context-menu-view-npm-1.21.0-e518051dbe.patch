+    // Portaling the live subview breaks when its host re-lays it out mid-
+    // interaction (New Architecture commits a frame -> child onLayout ->
+    // UITargetedPreview invalidated -> lift dismissed, e.g. a sortable item
+    // snapping back or going blank).
+    UIView *previewView = _customView != nil ? _customView : self.reactSubviews.firstObject;
     UIPreviewTarget* previewTarget = [[UIPreviewTarget alloc] initWithContainer:self center:self.reactSubviews.firstObject.center];
-    
